{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "帧与业务包数据流",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [1080, 620],
    "views": [
      {
        "id": "frame-layer",
        "label": "切成通信帧",
        "focus": ["pkt-client", "echo-client", "frame"],
        "note": "WS 自带帧边界；TCP 必须用 opcode + 长度切开。"
      },
      {
        "id": "magic-split",
        "label": "Magic 分流",
        "focus": ["frame", "magic", "basic", "logic"],
        "note": "Binary payload 前 4 字节决定心跳还是业务。"
      },
      {
        "id": "deliver",
        "label": "本地或转发",
        "focus": ["basic", "pong", "logic", "chat"],
        "note": "ping 在网关结束；LogicPkt 按 command 前缀交给 Chat。"
      }
    ]
  },
  "stages": [
    { "label": "发出" },
    { "label": "通信帧" },
    { "label": "Magic" },
    { "label": "分流" },
    { "label": "投递" }
  ],
  "nodes": [
    {
      "id": "pkt-client",
      "type": "frontend",
      "label": "pkt-client",
      "sublabel": "Binary 帧",
      "tag": "Web",
      "stage": 0,
      "row": 0
    },
    {
      "id": "echo-client",
      "type": "frontend",
      "label": "echo-client",
      "sublabel": "TCP 字节流",
      "tag": "App 路径",
      "stage": 0,
      "row": 2
    },
    {
      "id": "frame",
      "type": "messagebus",
      "label": "Frame",
      "sublabel": "opcode + payload",
      "tag": "有边界",
      "stage": 1,
      "row": 1
    },
    {
      "id": "magic",
      "type": "backend",
      "label": "Magic",
      "sublabel": "payload 前 4 字节",
      "tag": "kim-protocol",
      "stage": 2,
      "row": 1
    },
    {
      "id": "basic",
      "type": "backend",
      "label": "BasicPkt",
      "sublabel": "CODE_PING",
      "tag": "心跳",
      "stage": 3,
      "row": 0
    },
    {
      "id": "logic",
      "type": "backend",
      "label": "LogicPkt",
      "sublabel": "Header + body",
      "tag": "chat.demo.echo",
      "stage": 3,
      "row": 2
    },
    {
      "id": "pong",
      "type": "backend",
      "label": "本地 pong",
      "sublabel": "不 Forward",
      "tag": "网关",
      "stage": 4,
      "row": 0
    },
    {
      "id": "chat",
      "type": "backend",
      "label": "fake-chat",
      "sublabel": "原 body 回声",
      "tag": "service chat",
      "stage": 4,
      "row": 2
    }
