  "flows": [
    {
      "id": "ws-to-frame",
      "from": "pkt-client",
      "to": "frame",
      "label": "RFC6455 Binary",
      "classification": "Web 长连接",
      "variant": "emphasis"
    },
    {
      "id": "tcp-to-frame",
      "from": "echo-client",
      "to": "frame",
      "label": "1B opcode + 4B LE",
      "classification": "TCP 分帧",
      "variant": "dashed"
    },
    {
      "id": "frame-to-magic",
      "from": "frame",
      "to": "magic",
      "label": "Binary payload",
      "classification": "业务包入口",
      "variant": "emphasis"
    },
    {
      "id": "magic-to-basic",
      "from": "magic",
      "to": "basic",
      "label": "MAGIC_BASIC_PKT",
      "classification": "心跳",
      "variant": "default"
    },
    {
      "id": "magic-to-logic",
      "from": "magic",
      "to": "logic",
      "label": "MAGIC_LOGIC_PKT",
      "classification": "业务",
      "variant": "emphasis"
    },
    {
      "id": "basic-to-pong",
      "from": "basic",
      "to": "pong",
      "label": "CODE_PING → pong",
      "classification": "网关本地",
      "variant": "default"
    },
    {
      "id": "logic-to-chat",
      "from": "logic",
      "to": "chat",
      "label": "service_name = chat",
      "classification": "Forward",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "先有边界，再有意思",
      "items": [
        "TCP 用长度前缀切开；WebSocket 帧自带边界",
        "两种电线的 payload 都解成同一套业务包"
      ]
    },
    {
      "dot": "violet",
      "title": "Magic 决定走哪条",
      "items": [
        "MAGIC_BASIC_PKT 是心跳，停在网关",
        "MAGIC_LOGIC_PKT 后面是 protobuf Header；command 前缀即服务名"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条投递",
      "items": [
        "ping 在网关本地回 pong，不到 Chat",
        "chat.demo.echo 经 Container.forward 到 fake-chat"
      ]
    }
  ]
}
