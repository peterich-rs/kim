# Copy to kim.env next to compose.yml, or run bootstrap.sh on a new VPS.
# Do not commit kim.env. Never use demo JWT/HMAC or the literal change-me.
#
# POSTGRES_PASSWORD must match the password inside DATABASE_URL
# (Compose does not expand nested ${VAR} in values). Same for REDIS_URL.
# Existing VPS kim.env secrets are not rewritten by bootstrap; missing keys
# fail preflight. Gossip encrypt lives in consul/secrets.hcl only.

KIM_IMAGE=ghcr.io/peterich-rs/kim:latest
KIM_ENV=production
KIM_JWT_SECRET=
KIM_INTERNAL_HMAC_SECRET=
POSTGRES_USER=kim
POSTGRES_PASSWORD=
POSTGRES_DB=kim
DATABASE_URL=postgres://kim:set-POSTGRES_PASSWORD@postgres:5432/kim
REDIS_PASSWORD=
REDIS_URL=redis://:set-REDIS_PASSWORD@redis:6379/0
RUST_LOG=info
ROYAL_URL=http://royal:8080
CONSUL_HTTP_ADDR=https://consul:8501
CONSUL_MANAGEMENT_TOKEN=
CONSUL_TOKEN_CHAT=
CONSUL_TOKEN_ROYAL=
CONSUL_TOKEN_GATEWAY=
CONSUL_TOKEN_ROUTER=

# In containers (compose sets these; listed for operators):
# CONSUL_CACERT=/etc/kim/consul-ca.pem
# CONSUL_CLIENT_CERT=/etc/kim/consul-client.pem
# CONSUL_CLIENT_KEY=/etc/kim/consul-client-key.pem

# Delivery rollout (keep 0 until SCAN prints empty_jti=0 invalid=0 wrong_type=0).
# Order: KIM_REQUIRE_JTI=1 → deploy/scan-empty-jti.sh (exit 0) →
# KIM_PENDING_RECEIPT_ROYAL=1 (Chat still 0) → KIM_PENDING_RECEIPT_CHAT=1.
# Rollback: Chat 0 first, then Royal 0. Never Chat=1 and Royal=0.
KIM_REQUIRE_JTI=0
KIM_PENDING_RECEIPT_ROYAL=0
KIM_PENDING_RECEIPT_CHAT=0

# Inbox materialization (royal / royal-2 only; chat does not read this).
# After lock coverage is live: backfill-inbox.sh + diff-inbox.sql zero tuple-diff, then set 1.
KIM_INBOX_MATERIALIZED=0

# edge profile only
KIM_DOMAIN=kim.ainexc.com
CADDY_EMAIL=ops@example.com
