# Copy to kim.env next to compose.yml. Do not commit kim.env.
#
# POSTGRES_PASSWORD must match the password inside DATABASE_URL
# (Compose does not expand nested ${VAR} in values).

KIM_IMAGE=ghcr.io/peterich-rs/kim:latest
KIM_JWT_SECRET=change-me
POSTGRES_USER=kim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kim
DATABASE_URL=postgres://kim:change-me@postgres:5432/kim
REDIS_URL=redis://redis:6379/0
RUST_LOG=info

# edge profile only
KIM_DOMAIN=kim.ainexc.com
CADDY_EMAIL=ops@example.com
