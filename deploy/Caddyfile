# Origin for {$KIM_DOMAIN} (default kim.ainexc.com).
#
# Product H5 is a Cloudflare Worker Route in front of this origin
# (orange-cloud A/AAAA still points here). Worker serves the SPA;
# /api/v1/auth/* and WebSocket Upgrade still land on this Caddy.
# Do NOT attach a Worker Custom Domain to this hostname — that
# replaces the origin and the VPS stops seeing API/WS.
#
# Orange-cloud: Cloudflare terminates browser TLS. Caddy HTTP-01
# will not see the challenge; use a Cloudflare Origin Certificate
# (Full Strict) or keep :80 for CF-to-origin HTTP (Full).
# Grey-cloud + this file owning :80/:443: Caddy can still HTTP-01,
# but the Worker Route never runs.
#
# If a reverse proxy already listens on 443, do not enable the edge
# profile; point that proxy at 127.0.0.1:8001 (WS) and :8080 (auth).

{
	email {$CADDY_EMAIL:ops@example.com}
}

{$KIM_DOMAIN:kim.ainexc.com} {
	encode gzip zstd

	handle /api/lookup {
		reverse_proxy router:8088
	}

	handle /api/v1/auth/* {
		reverse_proxy royal:8080
	}

	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	# Caddy 2 already forwards Upgrade. `{>Connection}` is v1 syntax and
	# is sent as a literal, so the gateway rejects the handshake.
	handle @websocket {
		reverse_proxy gateway:8001 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
	}
}
