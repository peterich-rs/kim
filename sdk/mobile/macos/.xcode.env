# Sourced by macos/Scripts/run_macos_assemble.sh and run_xcode_backend.sh.
# Xcode GUI PATH is /usr/bin:/bin:/usr/sbin:/sbin — no ~/.zshrc, so
# `which flutter` / `which cargo` fail unless these bins are prepended.
# Override locally with .xcode.env.local (gitignored).
export PATH="${HOME}/.cargo/bin:${HOME}/fvm/default/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
