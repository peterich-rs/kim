{
  "name": "@kim/web-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KIM Web SDK: WebSocket client for fake-gateway",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen-proto": "node scripts/gen-proto.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "KIM_SDK_E2E=1 vitest run --config vitest.config.ts tests/e2e.test.ts",
    "demo": "vite --config vite.config.ts",
    "app": "vite --config vite.app.config.ts",
    "app:local": "vite --config vite.app.config.ts --mode loopback",
    "build:app": "vite build --config vite.app.config.ts",
    "deploy:app": "npm run build:app && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "long": "^5.3.2",
    "lucide-react": "^1.37.0",
    "protobufjs": "^7.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
