{
  "name": "@kim/web-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KIM Web SDK: WebSocket client for fake-gateway",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen-proto": "node scripts/gen-proto.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "KIM_SDK_E2E=1 vitest run --config vitest.config.ts tests/e2e.test.ts",
    "demo": "vite --config vite.config.ts",
    "app": "vite --config vite.app.config.ts",
    "app:local": "vite --config vite.app.config.ts --mode loopback",
    "build:app": "vite build --config vite.app.config.ts",
    "deploy:app": "npm run build:app && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "long": "^5.3.2",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "next-themes": "^0.4.6",
    "protobufjs": "^8.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-virtuoso": "^4.18.12",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
